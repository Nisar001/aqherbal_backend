# AQ Herbal Backend - Test Environment

# Core
NODE_ENV=test
PORT=5001
APP_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PREFIX=/api/v1
TZ=Asia/Kolkata

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/aqherbal_test
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/aqherbal_test
DB_URL=mongodb://127.0.0.1:27017/aqherbal_test
DB_NAME=aqherbal_test

# Authentication
JWT_SECRET=test_jwt_secret_key_for_testing_purposes_only_1234567890
JWT_REFRESH_SECRET=test_refresh_secret_key_for_testing_purposes_only_1234567890
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=AQ Herbal Test <noreply@aqherbal.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
RAZORPAY_KEY_ID=rzp_test_local_test_key
RAZORPAY_KEY_SECRET=local_test_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=local_test_razorpay_webhook_secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_METHODS=card,netbanking,upi,wallet
RAZORPAY_METHODS=card,netbanking,upi
PAYMENT_CURRENCY=INR
PAYMENT_MAX_RETRIES=3
PAYMENT_RETRY_WINDOW=24

# Redis / Queue
REDIS_DISABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_DB=1
REDIS_CONNECT_TIMEOUT=10000
REDIS_KEY_PREFIX=aqherbal_test:

# Company / Support
COMPANY_NAME=AQ Herbal
COMPANY_ADDRESS=Mumbai, Maharashtra, India
COMPANY_GSTIN=
COMPANY_FSSAI_REGISTRATION=20525084000103
ADMIN_EMAIL=admin@test.aqherbal.local
SUPPORT_EMAIL=support@test.aqherbal.local
SUPPORT_PHONE=+91-9876543210

# Business Rules
TAX_RATE=0
GST_RATE=0.18
FREE_SHIPPING_THRESHOLD=500
SHIPPING_COST=0
EXPRESS_SHIPPING_COST=100
LOW_STOCK_THRESHOLD=10
OUT_OF_STOCK_THRESHOLD=0
REORDER_QUANTITY=50
ORDER_CANCELLATION_WINDOW=24
ORDER_RETURN_WINDOW=7
AUTO_CANCEL_PENDING_HOURS=48
MAX_COUPON_DISCOUNT=50
MIN_COUPON_ORDER_VALUE=100
VERIFIED_REVIEWS_ONLY=false
REVIEW_MODERATION=false

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=10000
SUSPICIOUS_RATE_LIMIT_MAX=10000
RATE_LIMIT_SENSITIVE_WINDOW=5m
RATE_LIMIT_LOGIN_MAX=10000
RATE_LIMIT_REVIEW_MAX=10000
RATE_LIMIT_COUPON_MAX=10000
RATE_LIMIT_CONTACT_MAX=10000
RATE_LIMIT_WEBHOOK_MAX=10000

# Input Validation / Spam Protection
INPUT_MAX_DEPTH=8
INPUT_MAX_STRING_LENGTH=5000
SPAM_MAX_LINKS=20
SPAM_MAX_KEYWORD_HITS=20
SPAM_MAX_PAYLOAD_BYTES=51200
SPAM_MAX_REPEAT_RUN=50

# Security
BLACKLISTED_IPS=
IP_BLACKLIST=

# Shipment Tracking
ENABLE_SHIPMENT_TRACKING_JOB=false
SHIPMENT_TRACKING_CRON=0 */4 * * *
INDIA_POST_API_URL=https://www.indiapost.gov.in/_layouts/15/dop.portal.tracking/trackconsignment.aspx
INDIA_POST_TIMEOUT=10000
USE_INDIA_POST_AGGREGATOR=false
TRACKING_AGGREGATOR_URL=
TRACKING_AGGREGATOR_API_KEY=
