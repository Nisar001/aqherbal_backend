# AQ Herbal Backend - Environment Template
# Copy to .env and replace placeholders with real secrets for production.

# Core
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PREFIX=/api/v1
TZ=Asia/Kolkata

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/aqherbal
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/aqherbal_test
DB_URL=mongodb://127.0.0.1:27017/aqherbal
DB_NAME=aqherbal

# Authentication
JWT_SECRET=replace_with_secure_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_secure_random_secret_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=AQ Herbal <noreply@aqherbal.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_METHODS=card,netbanking,upi,wallet
RAZORPAY_METHODS=card,netbanking,upi
PAYMENT_CURRENCY=INR
PAYMENT_MAX_RETRIES=3
PAYMENT_RETRY_WINDOW=24

# Redis / Queue
REDIS_DISABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000
REDIS_KEY_PREFIX=aqherbal:

# Company / Support
COMPANY_NAME=AQ Herbal
COMPANY_ADDRESS=Mumbai, Maharashtra, India
COMPANY_GSTIN=
COMPANY_FSSAI_REGISTRATION=20525084000103
ADMIN_EMAIL=admin@aqherbal.com
SUPPORT_EMAIL=support@aqherbal.com
SUPPORT_PHONE=+91-9876543210

# Business Rules
TAX_RATE=0.1
GST_RATE=0.18
FREE_SHIPPING_THRESHOLD=500
SHIPPING_COST=0
EXPRESS_SHIPPING_COST=100
LOW_STOCK_THRESHOLD=10
OUT_OF_STOCK_THRESHOLD=0
REORDER_QUANTITY=50
ORDER_CANCELLATION_WINDOW=24
ORDER_RETURN_WINDOW=7
AUTO_CANCEL_PENDING_HOURS=48
MAX_COUPON_DISCOUNT=50
MIN_COUPON_ORDER_VALUE=100
VERIFIED_REVIEWS_ONLY=false
REVIEW_MODERATION=true

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=200
SUSPICIOUS_RATE_LIMIT_MAX=20
RATE_LIMIT_SENSITIVE_WINDOW=5m
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REVIEW_MAX=15
RATE_LIMIT_COUPON_MAX=30
RATE_LIMIT_CONTACT_MAX=10
RATE_LIMIT_WEBHOOK_MAX=50

# Input Validation / Spam Protection
INPUT_MAX_DEPTH=8
INPUT_MAX_STRING_LENGTH=5000
SPAM_MAX_LINKS=5
SPAM_MAX_KEYWORD_HITS=3
SPAM_MAX_PAYLOAD_BYTES=51200
SPAM_MAX_REPEAT_RUN=12

# Security
BLACKLISTED_IPS=
IP_BLACKLIST=

# Shipment Tracking
ENABLE_SHIPMENT_TRACKING_JOB=false
SHIPMENT_TRACKING_CRON=0 */4 * * *
INDIA_POST_API_URL=https://www.indiapost.gov.in/_layouts/15/dop.portal.tracking/trackconsignment.aspx
INDIA_POST_TIMEOUT=10000
USE_INDIA_POST_AGGREGATOR=false
TRACKING_AGGREGATOR_URL=
TRACKING_AGGREGATOR_API_KEY=
