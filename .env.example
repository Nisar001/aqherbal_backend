# Environment Configuration for aqherbal_backend

# Core
NODE_ENV=development
PORT=5000
DB_URL=mongodb://localhost:27017/aqherbal
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRES_IN=1d

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=200
SUSPICIOUS_RATE_LIMIT_MAX=20

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (required for media)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional)
REDIS_DISABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
