# Environment configuration — AQ Herbal NestJS backend
# Copy to .env and fill in real values. The app fails to boot if a required
# variable is missing (see src/config/env.validation.ts).

NODE_ENV=development
PORT=5000

# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/aqherbal?schema=public"

# JWT — required, min 32 chars each
JWT_ACCESS_SECRET=change_me_to_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS allow-list (storefront + admin panel)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Redis — set REDIS_DISABLED=false and REDIS_URL to use Redis in production
REDIS_DISABLED=true
REDIS_URL=redis://localhost:6379

# OTP / SMS (MSG91). If unset, OTP codes are logged to the console instead.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Email (nodemailer SMTP). If unset, emails are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AQ Herbal <noreply@aqherbal.com>"

# AWS S3 — product/review images and invoice PDFs.
# Leave empty in dev: image upload endpoints return 503 until configured.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
# Optional CDN / custom public base URL (defaults to the bucket URL)
AWS_S3_PUBLIC_URL=

# Razorpay (Phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App URLs
APP_URL=http://localhost:5000

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10
OTP_THROTTLE_TTL=300000
OTP_THROTTLE_LIMIT=5

# Shadow database for prisma migrate (dev only, any empty db)
SHADOW_DATABASE_URL=postgresql://user:pass@localhost:5432/aqherbal_shadow

# Store owner notifications (order/contact alerts) — required in production
OWNER_EMAIL=owner@example.com
# Sender identity (e.g. "AQ Herbal <orders@aqherbal.in>") — must be verified with your provider
EMAIL_FROM=
# Dev-only Razorpay simulator — MUST be false (or unset) in production
RAZORPAY_MOCK=false
