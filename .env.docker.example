# Copy to .env.docker and adjust secrets before running docker-compose
NODE_ENV=production
PORT=5000
APP_URL=http://localhost:5000

DB_URL=mongodb://mongo:27017/aqherbal
DB_NAME=aqherbal

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=200
SUSPICIOUS_RATE_LIMIT_MAX=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

REDIS_DISABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
